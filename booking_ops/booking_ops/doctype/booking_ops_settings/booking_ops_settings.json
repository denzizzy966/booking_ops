  {
   "fieldname": "webhook_url",
   "fieldtype": "Data",
   "label": "URL Webhook",
   "read_only": 1
  },
  {
   "fieldname": "webhook_help",
   "fieldtype": "HTML",
   "label": "Petunjuk",
   "options": "<p>Di Beds24 buka <b>Settings → Properties → Access → Booking Webhook</b>, isi URL di atas, versi <b>2 – with personal data</b>. Setiap booking baru/berubah langsung masuk ke ERPNext. Tanpa webhook, sinkron berkala tiap 5 menit tetap berjalan.</p>"
  },
