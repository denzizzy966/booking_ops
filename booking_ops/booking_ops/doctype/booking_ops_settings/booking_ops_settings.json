 "fields": [
  {
   "fieldname": "sb_conn",
   "fieldtype": "Section Break",
   "label": "Koneksi Beds24"
  },
  {
   "fieldname": "sandbox_mode",
   "fieldtype": "Check",
   "label": "Mode Sandbox (coba tanpa akun Beds24)",
   "default": "0",
   "description": "Centang untuk memakai Beds24 tiruan berisi data contoh (2 properti, 4 tipe kamar, booking di sekitar hari ini). Semua fitur jalan — termasuk Sales Order — tanpa menghubungi beds24.com. Matikan sebelum menghubungkan akun asli."
  },
  {
   "fieldname": "api_base",
   "fieldtype": "Data",
   "label": "Alamat API",
   "default": "https://beds24.com/api/v2",
   "description": "Biarkan default. Ganti hanya untuk server uji.",
   "depends_on": "eval:!doc.sandbox_mode"
  },
  {
   "fieldname": "invite_code",
   "fieldtype": "Password",
   "label": "Invite Code",
   "description": "Beds24 → Settings → Apps & Integrations → API → Generate invite code. Centang scope: bookings, bookings-personal, bookings-financial, inventory, properties. Tempel di sini lalu klik <b>Hubungkan</b>.",
   "depends_on": "eval:!doc.sandbox_mode"
  },
  {
   "fieldname": "connect_btn",
   "fieldtype": "Button",
   "label": "Hubungkan ke Beds24",
   "depends_on": "eval:!doc.sandbox_mode"
  },
  {
   "fieldname": "long_life_token",
   "fieldtype": "Password",
   "label": "Long Life Token (opsional)",
   "description": "Alternatif invite code: token permanen dari halaman API Beds24.",
   "depends_on": "eval:!doc.sandbox_mode"
  },
  {
   "fieldname": "refresh_token",
   "fieldtype": "Password",
   "label": "Refresh Token",
