  },
  {
   "fieldname": "sandbox_help",
   "fieldtype": "HTML",
   "options": "<div class=\"text-muted small\"><b>Langkah cepat:</b> Simpan → isi bagian <i>Sales Order</i> (Company, Item kamar) → klik <b>Ambil Properti &amp; Kamar</b> → <b>Reset Data Sandbox</b> (menarik semua booking contoh + membuat Sales Order). Lalu buka aplikasi. Tombol simulasi meniru booking/pembatalan yang datang dari Booking.com, Airbnb, dll. lewat webhook.</div>"
  },
  {
   "fieldname": "sandbox_ota_btn",
   "fieldtype": "Button",
   "label": "Simulasi Booking Baru dari OTA"
  },
  {
   "fieldname": "sandbox_cancel_btn",
   "fieldtype": "Button",
   "label": "Simulasi Pembatalan dari OTA"
  },
  {
   "fieldname": "cb_sandbox",
